# Workflow State Engine — Environment Variables
# Copy this to .env and fill in your keys:
#   cp .env.template .env

# === Required (docker compose) ===
# Consumed by docker-compose.example.yaml and config/opencode.json.

# OpenCode provider key (models: opencode/*)
OPENCODE_API_KEY=

# SumoPod OpenAI-compatible provider
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=
# Model ID used for provider routing and fallbacks (e.g. glm-5.3-flash)
SUMOPOD_BASE_MODEL=
# Display name for SUMOPOD_BASE_MODEL (e.g. GLM 5.3 Flash)
SUMOPOD_BASE_MODEL_NAME=

# Context7 MCP docs lookup
CONTEXT7_API_KEY=

# === Optional (Graphify semantic extraction) ===
# LLM-powered semantic extraction (entity/relationship detection).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for API-based embeddings in graphify (faster than local).
OPENAI_API_KEY=
