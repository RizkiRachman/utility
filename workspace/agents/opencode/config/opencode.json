  "mcp": {
    "servers": {
      "lean-ctx": {
        "type": "local",
        "command": [
          "lean-ctx"
        ],
        "environment": {
          "LEAN_CTX_DATA_DIR": "/home/node/.local/share/opencode/lean-ctx"
        }
      },
      "graphify": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "exec graphify-mcp --graph \"${GRAPHIFY_GRAPH:-${GRAPHIFY_ROOT:-/home/node/workspace}/graphify-out/graph.json}\""
        ],
        "disabled": true,
        "environment": {
          "OPENAI_API_KEY": "{env:SUMOPOD_API_KEY}",
          "OPENAI_BASE_URL": "{env:SUMOPOD_BASE_URL}"
        }
      },
      "context7": {
        "type": "local",
        "command": [
          "context7-mcp"
        ],
        "environment": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "memory": {
        "type": "local",
        "command": [
          "mcp-server-memory"
        ],
        "env": {
          "MEMORY_FILE_PATH": "/home/node/.local/share/opencode/memory/memory.jsonl"
        }
      },
      "fetch": {
        "type": "local",
        "command": [
          "mcp-server-fetch"
        ]
      },
      "everything": {
        "type": "local",
        "command": [
          "mcp-server-everything"
        ]
      },
      "rag": {
        "type": "local",
        "command": [
          "node",
          "/opt/rag/server.js"
        ],
        "enabled": true
      }
    }
  }
}
