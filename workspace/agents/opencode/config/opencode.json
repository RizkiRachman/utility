{
  "$schema": "https://opencode.ai/config.json",
  "model": "sumopod/glm-5.3-flash",
  "default_agent": "build",
  "update": "disable",
  "lsp": false,
  "snapshots": false,
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.runtime/**",
      "**/target/**",
      "**/logs/**",
      "**/.git/**",
      "**/graphify-out/**"
    ]
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "lean-ctx_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "firecrawl_alexandria",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/opencode.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/contract.json",
      "effect": "deny"
    }
  ],
  "plugins": [
    "/opt/engine/plugins/opencode-firecrawl"
  ],
  "providers": {
    "sumopod": {
      "name": "SumoPod",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:SUMOPOD_BASE_URL}",
        "apiKey": "{env:SUMOPOD_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        }
      }
    }
  },
  "agents": {
    "build": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permissions": [
        {
          "action": "read",
          "resource": "*.env",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        }
      ]
    },
