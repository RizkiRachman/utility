{
  "$schema": "https://opencode.ai/config.json",
  "model": "sumopod/glm-5.3-flash",
  "default_agent": "orchestrator",
  "update": "disable",
  "lsp": false,
  "snapshots": false,
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.runtime/**",
      "**/target/**",
      "**/logs/**",
      "**/.git/**"
    ]
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "write",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "task",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "lean-ctx_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "rag_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "openui_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "fetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "opencode_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "firecrawl_developer_search",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "firecrawl_alexandria",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/opencode.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/contract.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.env*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.env*",
      "effect": "deny"
    }
  ],
  "plugins": [
    "/opt/engine/plugins/opencode-firecrawl"
  ],
  "providers": {
    "sumopod": {
      "name": "SumoPod",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:SUMOPOD_BASE_URL}",
        "apiKey": "{env:SUMOPOD_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        }
      }
    }
  },
  "agents": {
    "build": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permissions": [
        {
          "action": "read",
          "resource": "*.env",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        }
      ]
    },
