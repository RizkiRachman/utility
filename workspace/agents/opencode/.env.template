# .env.template for docker compose (copy to .env and fill in)
# All values are optional: the compose files carry working defaults.

# Required for OpenCode auth (compose default is a placeholder)
OPENCODE_API_KEY=REPLACE_ME

# Model provider (compose defaults exist for all three)
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=
SUMOPOD_BASE_MODEL=

# Context7 docs MCP (compose default is a placeholder)
CONTEXT7_API_KEY=

# Optional Firecrawl key for the vendored @firecrawl/opencode plugin.
# Leave empty: firecrawl_developer_search works keyless and CLI-free.
# firecrawl_alexandria and the firecrawl-cli skills require it (or OAuth).
FIRECRAWL_API_KEY=

# Portal: the key you enter once on the portal landing page (http://127.0.0.1:4097).
# Also enables HTTP basic auth on the opencode server itself. Leave empty to
# run the portal in cookie-only mode (no Authorization header injection).
OPENCODE_SERVER_PASSWORD=
# Optional portal and serve username (compose default: opencode)
OPENCODE_SERVER_USERNAME=
# Optional zero-click mode: portal proxies without showing the landing page
PORTAL_AUTO_LOGIN=false
# Optional stable HMAC secret for portal session cookies; keep it set to
# preserve sessions across portal restarts (a random secret is generated when empty)
PORTAL_COOKIE_SECRET=
