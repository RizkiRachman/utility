# .env.template for docker compose (copy to .env and fill in)
# All values are optional: the compose files carry working defaults.

# Required for OpenCode auth (compose default is a placeholder)
OPENCODE_API_KEY=REPLACE_ME

# Model provider (compose defaults exist for all three)
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=
SUMOPOD_BASE_MODEL=

# Context7 docs MCP (compose default is a placeholder)
CONTEXT7_API_KEY=

# Optional Firecrawl key for the vendored @firecrawl/opencode plugin.
# Leave empty: firecrawl_developer_search works keyless and CLI-free.
# firecrawl_alexandria and the firecrawl-cli skills require it (or OAuth).
FIRECRAWL_API_KEY=

# Key for OpenCode's own auth (pairing screen / HTTP basic auth on the opencode server). Leave empty to disable.
OPENCODE_SERVER_PASSWORD=

# Optional real embeddings endpoint for the rag MCP server. All three must be
# set to leave local hashed-vector mode; local mode is deterministic, needs no
# network, and works fully offline (the pre-install store needs nothing for it).
# RAG_EMBEDDINGS_URL points at an OpenAI-compatible /v1/embeddings endpoint,
# RAG_EMBEDDINGS_MODEL is the model id, RAG_EMBEDDINGS_KEY its bearer key.
RAG_EMBEDDINGS_URL=
RAG_EMBEDDINGS_MODEL=
RAG_EMBEDDINGS_KEY=
