# .env.template for docker compose (copy to .env and fill in)
# Required: OPENCODE_API_KEY. Optional values carry working defaults.

# Required for OpenCode auth (compose default is a placeholder)
OPENCODE_API_KEY=REPLACE_ME

# Primary model provider (live). Get a key at openrouter.ai
OPENROUTER_API_KEY=

# Declared fallback provider, currently INACTIVE: no API key available.
# Keep empty. Entries stay in config/opencode.json as last-declared fallback.
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=
SUMOPOD_BASE_MODEL=

# Context7 docs MCP (compose default is a placeholder)
CONTEXT7_API_KEY=

# Optional Firecrawl key for the vendored @firecrawl/opencode plugin.
# Leave empty: firecrawl_developer_search works keyless and CLI-free.
# firecrawl_alexandria and the firecrawl-cli skills require it (or OAuth).
FIRECRAWL_API_KEY=

# Key for OpenCode own auth (pairing screen / HTTP basic auth on the opencode server). Leave empty to disable.
# Production guidance: set this, or bind the service to localhost. Empty default means the server accepts unauthenticated peers on its port.
OPENCODE_SERVER_PASSWORD=

# Deployment mode gate (entrypoint): dev (default; empty OPENCODE_SERVER_PASSWORD
# allowed) or production (requires OPENCODE_SERVER_PASSWORD, or
# OPENCODE_BIND_LOCALHOST=1 as the explicit loopback-only trade-off). Any other
# value fails closed at boot.
OPENCODE_DEPLOY_MODE=dev

# production only: 1 = bind the server to the container loopback instead of all
# interfaces. You must ALSO publish the host port on loopback, e.g. in
# docker-compose.example.yaml:  ports: ["[IP_ADDRESS]:4096:4096"] (the shipped
# default already publishes on host loopback; this additionally hardens the
# in-container listener).
OPENCODE_BIND_LOCALHOST=0

# Where the workflow engine session state lives (contract.json / state.md /
# archive/ are seeded here at boot; idempotent, never overwrites).
OPENCODE_SESSION_DIR=/home/node/workspace/session

# Optional real embeddings endpoint for the rag MCP server. All three must be
# set to leave local hashed-vector mode; local mode is deterministic, needs no
# network, and works fully offline.
# RAG_EMBEDDINGS_URL points at an OpenAI-compatible /v1/embeddings endpoint,
# RAG_EMBEDDINGS_MODEL is the model id, RAG_EMBEDDINGS_KEY its bearer key.
RAG_EMBEDDINGS_URL=
RAG_EMBEDDINGS_MODEL=
RAG_EMBEDDINGS_KEY=
