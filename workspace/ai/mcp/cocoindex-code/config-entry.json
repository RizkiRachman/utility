{
  "cocoindex-code": {
    "type": "local",
    "command": [
      "docker", "run", "-i", "--rm",
      "-e", "HOME=/home/node",
      "-w", "/home/node/workspace",
      "-v", "/home/node/workspace:/home/node/workspace",
      "-v", "/home/node/.cocoindex_code:/home/node/.cocoindex_code",
      "-v", "/home/node/.cache/huggingface:/home/node/.cache/huggingface",
      "ccc-mcpserver:local", "ccc", "mcp"
    ],
    "enabled": true
  }
}
